# Production Environment Variables for Vercel

# IMPORTANT: Add these to your Vercel project settings
# Do NOT commit actual values to git

NODE_ENV=production

# JWT Configuration (REQUIRED)
# Generate a strong random string (minimum 32 characters)
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-change-this
JWT_EXPIRE=7d

# Database Configuration (REQUIRED)
# Use Vercel Postgres or external PostgreSQL provider
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://user:password@host:5432/notes_share_db

# Client URL (REQUIRED)
# Your Vercel deployment URL
# Update after first deployment
CLIENT_URL=https://your-app.vercel.app

# Optional: Socket.io URL (if using separate WebSocket server)
# VITE_SOCKET_URL=https://your-socket-server.com
